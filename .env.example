# Postgres (Render) - copy real values from .env
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=review_data
DB_SSL=true

PORT=8080
CORS_ORIGIN=*

# HS256 secret shared with the main backend that signs app tokens.
# When set, GET /api/logs accepts a Bearer JWT whose payload has
# isAdmin === true (or role === 'admin').
JWT_SECRET=

# Static fallback key for GET /api/logs when you don't want to wire
# JWT verification yet. Send it as: Authorization: Bearer <key>
ADMIN_API_KEY=
